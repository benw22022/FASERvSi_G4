universe = vanilla
executable = geom_bkg_sim.sh
arguments = $(ProcId) gps_2024_posTracks_missVetoNu.mac posTracks_2024_missVetoNu 
output = logs/job_2024_pos_missVetoNu_$(ProcId).outi
error = logs/job_2024_pos_missVetoNu_$(ProcId).err
log = logs/job_2024_pos_missVetoNu_$(ProcId).log
request_cpus = 1
max_materialize=256
+JobFlavour = "longlunch"
queue 1000
